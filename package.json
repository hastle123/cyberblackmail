{
  "name": "cyberblackmail",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push && tsx scripts/seed-scams.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "ingest": "tsx --env-file=.env.local scripts/ingest-rss.ts",
    "ingest:setup": "tsx scripts/ensure-rss-sources.ts",
    "enrich": "tsx scripts/enrich-articles.ts",
    "seed:scams": "tsx scripts/seed-scams.ts",
    "scams:ingest": "tsx --env-file=.env.local scripts/scams-ingest.ts",
    "process:local": "tsx --env-file=.env.local scripts/process-articles-local.ts",
    "covers:backfill": "tsx --env-file=.env.local scripts/backfill-cover-images.ts",
    "alerts:ru": "tsx --env-file=.env.local scripts/backfill-alerts-ru.ts",
    "map:backfill": "tsx scripts/backfill-map-incidents.ts",
    "translate": "tsx scripts/translate-articles.ts",
    "translate:all": "tsx --env-file=.env.local scripts/translate-all-local.ts",
    "translate:clean": "tsx --env-file=.env.local scripts/clean-fake-translations.ts",
    "translate:test": "tsx --env-file=.env.local scripts/test-free-translate.ts",
    "libretranslate:install": "powershell -ExecutionPolicy Bypass -File scripts/install-libretranslate.ps1",
    "libretranslate:start": "powershell -ExecutionPolicy Bypass -File scripts/start-libretranslate.ps1",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@extractus/article-extractor": "^8.1.0",
    "@prisma/client": "^6.8.2",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.12.1",
    "next": "^15.3.3",
    "next-auth": "^4.24.11",
    "next-intl": "^4.13.0",
    "prisma": "^6.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-force-graph-2d": "^1.27.1",
    "react-simple-maps": "^3.0.0",
    "rss-parser": "^3.13.0",
    "topojson-client": "^3.1.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/topojson-client": "^3.1.5",
    "dotenv": "^16.6.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
