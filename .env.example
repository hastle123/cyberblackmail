DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET="change-me-cron-secret"
# Articles to enrich per cron run (full text fetch). Default: 3
ENRICH_LIMIT="3"
ADMIN_EMAIL="admin@cyberblackmail.local"
ADMIN_PASSWORD="ChangeMe123!"

# --- Бесплатный перевод RSS на русский (достаточно одного ключа) ---
# Gemini (рекомендуется): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"

# Groq (альтернатива): https://console.groq.com/keys
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"

# OpenAI (платный, опционально)
OPENAI_API_KEY=""

# --- Локальный Ollama (RTX 3060 / 32GB RAM) ---
# Установка: https://ollama.com → ollama pull llama3.2
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL=gemma3:12b
# Сколько статей обработать за запуск: npm run process:local
PROCESS_LIMIT="5"

# --- Резервные бесплатные API перевода (Lingva + LibreTranslate + MyMemory) ---
# dual = Ollama и облачные API параллельно (быстрее) | fast = только API | quality = сначала Ollama
TRANSLATE_MODE="dual"
# Lingva instances (через запятую). Свой сервер: http://localhost:3001
# LINGVA_INSTANCES="https://lingva.ml,https://lingva.garudalinux.org"
# LibreTranslate: свой Docker (без лимитов) — npm run libretranslate:install
# LIBRETRANSLATE_URL=http://127.0.0.1:5000
# MyMemory: email даёт 50k символов/день бесплатно
# MYMEMORY_EMAIL=your@email.com
# Какие провайдеры использовать: lingva,libretranslate,mymemory
# FREE_TRANSLATE_PROVIDERS="lingva,libretranslate,mymemory"
